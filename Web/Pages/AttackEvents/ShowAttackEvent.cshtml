@page "/show-attack-event/{id:int}"
@model ShowAttackEventModel
@{
}

@section Meta {
    <title>Webbsida - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🛎️
        @(Model.AttackEvent.TargetName)
        @(Model.AttackEvent.TargetAddress)
    </h4>

    <dl class="notice">
        <dt>När</dt>
        <dd>@(Model.AttackEvent.Created.ToFixedFormatDateShortTime())</dd>

        @* <dt>Sida</dt>
        <dd>@(Model.AttackEvent.PayloadPage.Comment)</dd> *@

        <dt>URL</dt>
        <dd>@(Model.AttackEvent.Url)</dd>

        @* <dt>Metod</dt>
        <dd>@(Model.AttackEvent.Method)</dd> *@

        <dt>UserAgent</dt>
        <dd>@(Model.AttackEvent.UserAgent)</dd>

        <dt>Ip-nummer</dt>
        <dd>@(Model.AttackEvent.IpAddress)</dd>
    </dl>

    <p>
        @if (Model.CanRemoveAttackEvent)
        {
            <a class="button" href="/remove-attack-event/@(Model.AttackEvent.Id)">
                Ta bort
            </a>
        }
    </p>

</main>
