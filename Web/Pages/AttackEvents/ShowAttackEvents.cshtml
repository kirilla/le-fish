@page "/show-attack-events"
@model ShowAttackEventsModel
@{
}

@section Meta {
    <title>
        Sidbesök -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Sidbesök
    </h4>

    <div class="notice">

        <ul>
            @foreach (var evt in Model.AttackEvents)
            {
                <li>
                    🛎️
                    &thinsp;
                    <a href="/show-attack-event/@(evt.Id)">
                        @(evt.TargetAddress)
                        &thinsp;
                        @(evt.PageName)
                        &thinsp;
                        @(evt.Created.ToFixedFormatDateShortTime())
                    </a>
                </li>
            }

            @if (!Model.AttackEvents.Any())
            {
                <li>
                    🛎️
                    &thinsp;
                    &ndash;
                </li>
            }
        </ul>

    </div>

    <p>
        <a class="button" href="/remove-attack-events">
            Ta bort sidbesök
        </a>
    </p>

</main>
