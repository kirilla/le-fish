@page "/remove-attack-events/{id:int}"
@model RemoveAttackEventsModel
@{
}

@section Meta {
    <title>
        Ta bort händelser -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🎯
        <a href="/show-target/@(Model.Target.Id)">@(Model.Target.Name)</a>
        <br />
        🔥
        <a href="/show-attack/@(Model.Attack.Id)">@(Model.Attack.Value)</a>
    </h4>

    <h5>
        Ta bort händelser
    </h5>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.AttackId" />

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-attack-events/@(Model.Attack.Id)">
            Avbryt
        </a>

    </form>

</main>
