@page "/show-payload-script/{id:int}"
@model ShowPageScriptModel
@{
}

@section Meta {
    <title>Skript - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        📜
        @(Model.PageScript.Name)
    </h4>

    <h5>
        URL
    </h5>
    <p class="notice">
        @(Model.Config.ScriptUrl ?? "Missing config, see appsettings.json")
    </p>

    <h5>
        Skript
    </h5>
    <pre class="notice">@(Model.PageScript.Script)</pre>

    <p>
        @if (Model.CanClonePageScript)
        {
            <a class="button" href="/clone-payload-script/@(Model.PageScript.Id)">
                Klona
            </a>
        }

        @if (Model.CanEditPageScript)
        {
            <a class="button" href="/edit-payload-script/@(Model.PageScript.Id)">
                Redigera
            </a>
        }

        @if (Model.CanRemovePageScript)
        {
            <a class="button" href="/remove-payload-script/@(Model.PageScript.Id)">
                Ta bort
            </a>
        }
    </p>

</main>
