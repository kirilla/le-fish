@page "/remove-email-template/{id:int}"
@model RemoveEmailTemplateModel
@{
}

@section Meta {
    <title>
        Ta bort epostmall -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Ta bort epostmallen:
        @(Model.EmailTemplate.Subject)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.EmailTemplateId" />

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-email-template/@(Model.CommandModel.EmailTemplateId)">
            Avbryt
        </a>
    </form>

</main>
