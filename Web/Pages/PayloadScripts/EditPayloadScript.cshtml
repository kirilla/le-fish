@page "/edit-payload-script/{id:int}"
@model EditPageScriptModel
@{
}

@section Meta {
    <title>
        Redigera skript -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Redigera skriptet:
        @(Model.PayloadScript.Name)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.PayloadScriptId" />

        <label asp-for="CommandModel.Name">
            Namn
        </label>
        <input asp-for="CommandModel.Name" />

        <label asp-for="CommandModel.Script">
            Skript
        </label>
        <textarea asp-for="CommandModel.Script" rows="10"></textarea>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Spara
        </button>

        <a class="button" href="/show-payload-script/@(Model.PayloadScript.Id)">
            Avbryt
        </a>
    </form>

</main>
