@page "/show-payload-script/{id:int}"
@model ShowPayloadScriptModel
@{
}

@section Meta {
    <title>Skript - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        📜
        @(Model.PayloadScript.Name)
    </h4>

    <h5>
        URL
    </h5>
    <p class="notice">
        @(Model.Config.ScriptUrl ?? "Missing config, see appsettings.json")
    </p>

    <h5>
        Skript
    </h5>
    <pre class="notice">@(Model.PayloadScript.Script)</pre>

    <h5>
        Nycklar
    </h5>

    <ul class="notice">
        @foreach (var key in Model.PageKeys)
        {
            <li>
                🔑
                &thinsp;
                @(key.Value)
                    &thinsp;
                <a href="/show-page-key/@(key.Id)">Visa nyckel</a>
                &ensp;
                <a href="/page/@(key.Value)">Besök som</a>
                &thinsp;
                @(key.TargetName), @(key.TargetAddress)
            </li>
        }

        @if (!Model.PageKeys.Any())
        {
            <li>
                🔑
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

    <p>
        @if (Model.CanClonePayloadScript)
        {
            <a class="button" href="/clone-payload-script/@(Model.PayloadScript.Id)">
                Klona
            </a>
        }

        @if (Model.CanEditPayloadScript)
        {
            <a class="button" href="/edit-payload-script/@(Model.PayloadScript.Id)">
                Redigera
            </a>
        }

        @if (Model.CanRemovePayloadScript)
        {
            <a class="button" href="/remove-payload-script/@(Model.PayloadScript.Id)">
                Ta bort
            </a>
        }
    </p>

</main>
