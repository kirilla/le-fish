@page "/remove-payload-script/{id:int}"
@model RemovePayloadScriptModel
@{
}

@section Meta {
    <title>
        Ta bort skript -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Ta bort skriptet:
        @(Model.PayloadScript.Name)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.PayloadScriptId" />

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-payload-script/@(Model.CommandModel.PayloadScriptId)">
            Avbryt
        </a>
    </form>

</main>
