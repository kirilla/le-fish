@page "/attack"
@model AttackModel
@{
}

@section Meta {
    <title>Attack - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Attack
    </h4>

    <div class="notice">
        @if (!Model.Targets.Any())
        {
            <div>
                🎯
                &thinsp;
                &ndash;
            </div>
        }

        @foreach (var target in Model.Targets)
        {
            <div>
                🎯
                &thinsp;
                <a href="/show-target/@(target.Id)">@(target.Name)</a>
                &thinsp;
                <span class="muted">
                    @(target.Address)
                </span>
            </div>

            var attacks = Model.Attacks
               .Where(x => x.TargetId == target.Id)
               .ToList();

            @foreach (var attack in attacks)
            {
                <div>
                    🔥
                    &thinsp;
                    <a href="/show-attack/@(attack.Id)">@(attack.Value)</a>
                    &ensp;
                    <span class="muted">
                        @(attack.Created.ToFixedFormatDateShortTime())
                    </span>
                </div>
            }

            @if (attacks.Any())
            {
                <br />
            }
        }
    </div>

    <p>
        @if (Model.CanSendEmail)
        {
            <a class="button" href="/send-email">
                Skicka meddelande
            </a>
        }
    </p>

</main>
