@page "/attack"
@model AttackModel
@{
}

@section Meta {
    <title>Attack - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Attack
    </h4>

    <div class="notice">
        @if (!Model.EmailTargets.Any())
        {
            <div>
                🎯
                &thinsp;
                &ndash;
            </div>
        }

        @foreach (var target in Model.EmailTargets)
        {
            <div>
                🎯
                &thinsp;
                <a href="/show-email-target/@(target.Id)">@(target.Name)</a>
                &thinsp;
                <span class="muted">
                    @(target.Address)
                </span>
            </div>

            @foreach (var message in Model.EmailMessages
               .Where(x => x.EmailTargetId == target.Id))
            {
                <div style="padding-left:1.5em;">
                    <span>
                        📩
                        &thinsp;
                        <a href="/show-email/@(message.Id)">@(message.Subject)</a>
                        &thinsp;
                        <span class="muted">
                            skickat @(message.Sent.ToFixedFormatDateShortTime())
                        </span>
                    </span>

                    @foreach (var token in Model.PageTokens
                       .Where(x => x.EmailMessageId == message.Id))
                    {
                        <div style="padding-left:1.5em;">
                            <div>
                                🍪
                                &thinsp;
                                <a href="/show-page-key/@(token.Id)">@(token.Token)</a>
                            </div>

                            @foreach (var visit in Model.Visits
                                .Where(x => x.PageKeyId == token.Id))
                            {
                                if (visit.VisitKind == VisitKind.Page)
                                {
                                    <div style="padding-left:1.5em;">
                                        📄
                                        &thinsp;
                                        <a href="/show-payload-page/@(visit.PayloadPageId)">@(visit.PageName)</a>
                                        &thinsp;
                                        <span class="muted">
                                            besökt @(visit.Created.ToFixedFormatDateShortTime())
                                        </span>
                                    </div>
                                }

                                if (visit.VisitKind == VisitKind.Script)
                                {
                                    <div style="padding-left:1.5em;">
                                        📜
                                        &thinsp;
                                        <a href="/show-payload-script/@(visit.PayloadScriptId)">@(visit.ScriptName)</a>
                                        &thinsp;
                                        <span class="muted">
                                            besökt @(visit.Created.ToFixedFormatDateShortTime())
                                        </span>
                                    </div>
                                }
                            }

                            @if (!Model.Visits
                                .Any(x => x.PageKeyId == token.Id))
                            {
                                <div style="padding-left:1.5em;">
                                    📄
                                    &thinsp;
                                    &ndash;
                                </div>
                            }
                        </div>
                    }

                    @if (!Model.PageTokens
                        .Any(x => x.EmailMessageId == message.Id))
                    {
                        <div style="padding-left:1.5em;">
                            🍪
                            &thinsp;
                            &ndash;
                        </div>
                    }
                </div>
                <br />
            }

            @if (!Model.EmailMessages.Any(x => x.EmailTargetId == target.Id))
            {
                <div style="padding-left:1.5em;">
                    📩
                    &thinsp;
                    &ndash;
                </div>
            }
            <br />
        }
    </div>

    <p>
        @if (Model.CanSendEmail)
        {
            <a class="button" href="/send-email">
                Skicka meddelande
            </a>
        }
    </p>

</main>
