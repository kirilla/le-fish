@page "/show-attack/{id:int}"
@model ShowAttackModel
@{
}

@section Meta {
    <title>Attack - @(Model.Attack.Value) - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🎯
        @(Model.Attack.TargetName)<br />
        🔥
        @(Model.Attack.Value)
    </h4>

    <ul class="notice">
        @foreach (var message in Model.EmailHeaders)
        {
            <li>
                📧
                &thinsp;
                <a href="/show-email/@(message.Id)">
                    @(message.Subject)</a>
                &ensp;
                <span class="muted">
                    @(message.ToAddress)
                </span>
            </li>
        }
        <li>
            📄
            &thinsp;
            <a href="/show-payload-page/@(Model.Attack.PayloadPageId)">
                @(Model.Attack.PageName)
            </a>
        </li>
        <li>
            📜
            &thinsp;
            <a href="/show-payload-script/@(Model.Attack.PageScriptId)">
                @(Model.Attack.ScriptName)
            </a>
        </li>
        <li>
            &nbsp;&ensp;
        </li>
        <li>
            🔗
            &thinsp;
            <a href="/show-attack-urls/@(Model.Attack.Id)">
                Adresser
            </a>
        </li>
    </ul>

    <h5>
        Instruktioner
    </h5>

    <ul class="notice">
        @foreach (var instruction in Model.TargetInstructions)
        {
            <li>
                ❇️
                &thinsp;
                <a href="/show-target-instruction/@(instruction.Id)">
                    @(instruction.Name)
                </a>
                &ensp;
                @if (instruction.InstructionStatus == InstructionStatus.Waiting)
                {
                    <span class="muted">
                        Väntar.
                    </span>   
                }
                @if (instruction.InstructionStatus == InstructionStatus.Fetched)
                {
                    <span class="muted">
                        Hämtad @(instruction.Fetched.ToFixedFormatDateShortTime())
                    </span>   
                }
            </li>
        }
        @if (!Model.TargetInstructions.Any())
        {
            <li>
                ❇️
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

    <p>
        <a class="button" 
            href="/add-or-select-instruction/@(Model.Attack.Id)">
            Lägg till instruktion
        </a>
    </p>

    <h5>
        Händelser
    </h5>

    <figure>
        <table>
            <tr>
                <th></th>
                <th>Tid</th>
                <th>IP-nummer</th>
                <th>UserAgent</th>
            </tr>
            @foreach (var evt in Model.AttackEvents)
            {
                <tr>
                    <td>
                        @if (evt.AttackEventKind == AttackEventKind.PageVisit)
                        {
                            <span>📄</span>
                        }
                        @if (evt.AttackEventKind == AttackEventKind.ScriptDownload)
                        {
                            <span>📜</span>
                        }
                        @if (evt.AttackEventKind == AttackEventKind.FetchInstruction)
                        {
                            <span>❇️</span>
                        }
                        @if (evt.AttackEventKind == AttackEventKind.UploadData)
                        {
                            <span>🧺</span>
                        }
                    </td>
                    <td>
                        <a href="/show-attack-event/@(evt.Id)">
                            @(evt.Created.ToFixedFormatDateShortTime())
                        </a>
                    </td>
                    <td>
                        @(evt.IpAddress)
                    </td>
                    <td>
                        @(evt.UserAgent)
                    </td>
                </tr>
            }
            @if (!Model.AttackEvents.Any())
            {
                <tr>
                    <td colspan="3">
                        Inga
                    </td>
                </tr>
            }
        </table>
    </figure>

    <br />

    <br />

    @if (Model.UserAgents.Any())
    {
        <h5>
            Agent
        </h5>

        <ul class="notice">
            @foreach (var agent in Model.UserAgents)
            {
                <li>
                    @(agent)
                </li>
            }
        </ul>
    }

    @if (Model.IpAddresses.Any())
    {
        <h5>
            IP-nummer
        </h5>

        <ul class="notice">
            @foreach (var address in Model.IpAddresses)
            {
                <li>
                    @(address)
                </li>
            }
        </ul>
    }

    <h5>
        Exfiltrerad data
    </h5>

    <ul class="notice">
        @foreach (var result in Model.DataResults)
        {
            <li>
                🧺
                &thinsp;
                <a href="/show-data-result/@(result.Id)">
                    @(result.Created.ToFixedFormatDateShortTime())
                </a>
            </li>
        }
        @if (!Model.DataResults.Any())
        {
            <li>
                🧺
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

    <a class="button" href="/remove-attack/@(Model.Attack.Id)">
        Ta bort
    </a>

</main>
