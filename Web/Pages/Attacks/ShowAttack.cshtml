@page "/show-attack/{id:int}"
@model ShowAttackModel
@{
}

@section Meta {
    <title>Attack - @(Model.Attack.Value) - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🎯
        @(Model.Attack.TargetName)<br />
        🔥
        @(Model.Attack.Value)
    </h4>

    <ul class="notice">
        @foreach (var message in Model.EmailHeaders)
        {
            <li>
                📧
                &thinsp;
                <a href="/show-email/@(message.Id)">
                    @(message.Subject)</a>
                &ensp;
                <span class="muted">
                    @(message.ToAddress)
                </span>
            </li>
        }
        <li>
            📄
            &thinsp;
            <a href="/show-payload-page/@(Model.Attack.PayloadPageId)">
                @(Model.Attack.PageName)
            </a>
        </li>
        <li>
            📜
            &thinsp;
            <a href="/show-payload-script/@(Model.Attack.PayloadScriptId)">
                @(Model.Attack.ScriptName)
            </a>
        </li>
    </ul>

    <h5>
        Instruktioner
    </h5>

    <ul class="notice">
        @foreach (var instruction in Model.TargetInstructions)
        {
            <li>
                ❇️
                &thinsp;
                <a href="/show-target-instruction/@(instruction.Id)">
                    @(instruction.Name)
                </a>
                &ensp;
                <span class="muted">
                    @(instruction.InstructionStatus)
                </span>
            </li>
        }
        @if (!Model.TargetInstructions.Any())
        {
            <li>
                ❇️
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

    <p>
        <a class="button" 
            href="/add-or-select-instruction/@(Model.Attack.Id)">
            Lägg till instruktion
        </a>
    </p>

    <h5>
        Sidbesök
    </h5>

    <figure>
        <table>
            <tr>
                <th>&emsp;🙋</th>
                <th>IP-nummer</th>
                <th>UserAgent</th>
            </tr>
            @foreach (var visit in Model.PageVisits)
            {
                <tr>
                    <td>
                        <a href="/show-page-visit/@(visit.Id)">
                            @(visit.Created.ToFixedFormatDateShortTime())
                        </a>
                    </td>
                    <td>
                        @(visit.IpAddress)
                    </td>
                    <td>
                        @(visit.UserAgent)
                    </td>
                </tr>
            }
            @if (!Model.PageVisits.Any())
            {
                <tr>
                    <td colspan="3">
                        Inga
                    </td>
                </tr>
            }
        </table>
    </figure>

    <br />

    <h5>
        Skriptnedladdningar
    </h5>

    <figure>
        <table>
            <tr>
                <th>&emsp;🙋</th>
                <th>IP-nummer</th>
                <th>UserAgent</th>
            </tr>
            @foreach (var visit in Model.ScriptVisits)
            {
                <tr>
                    <td>
                        <a href="/show-script-visit/@(visit.Id)">
                            @(visit.Created.ToFixedFormatDateShortTime())
                        </a>
                    </td>
                    <td>
                        @(visit.IpAddress)
                    </td>
                    <td>
                        @(visit.UserAgent)
                    </td>
                </tr>
            }
            @if (!Model.ScriptVisits.Any())
            {
                <tr>
                    <td colspan="3">
                        Inga
                    </td>
                </tr>
            }
        </table>
    </figure>

    <br />

    @if (Model.UserAgents.Any())
    {
        <h5>
            Agent
        </h5>

        <ul class="notice">
            @foreach (var agent in Model.UserAgents)
            {
                <li>
                    @(agent)
                </li>
            }
        </ul>
    }

    @if (Model.IpAddresses.Any())
    {
        <h5>
            IP-nummer
        </h5>

        <ul class="notice">
            @foreach (var address in Model.IpAddresses)
            {
                <li>
                    @(address)
                </li>
            }
        </ul>
    }

    <h5>
        Exfiltrerad data
    </h5>

    <ul class="notice">
        @foreach (var dump in Model.DataDumps)
        {
            <li>
                🧺
                &thinsp;
                <a href="/show-data-dump/@(dump.Id)">
                    @(dump.Created.ToFixedFormatDateShortTime())
                </a>
            </li>
        }
        @if (!Model.DataDumps.Any())
        {
            <li>
                🧺
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

    <a class="button" href="/remove-attack/@(Model.Attack.Id)">
        Ta bort
    </a>

</main>
