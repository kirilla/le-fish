@page "/show-attacks"
@model ShowAttacksModel
@{
}

@section Meta {
    <title>
        Nycklar -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Nycklar
    </h4>

    <figure>
        <table>
            <tr>
                <th>&emsp;🔑</th>
                <th>Nyckel</th>
                <th>Mål</th>
                <th>Sida</th>
            </tr>
            @foreach (var key in Model.Attacks)
            {
                <tr>
                    <td>
                        @(key.Created.ToFixedFormatDateShortTime())
                    </td>
                    <td>
                        <a href="/show-attack/@(key.Id)">
                        @(key.Value)
                        </a>
                    </td>
                    <td>
                        <a href="/show-email-target/@(key.EmailTargetId)">
                        @(key.TargetName)
                        </a>
                    </td>
                    <td>
                        <a href="/show-payload-page/@(key.PayloadPageId)">
                        @(key.PageName)
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Attacks.Any())
            {
                <tr>
                    <td colspan="3">
                        Inga
                    </td>
                </tr>
            }
        </table>
    </figure>

</main>
