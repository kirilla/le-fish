@page "/show-attacks"
@model ShowAttacksModel
@{
}

@section Meta {
    <title>
        Attacker -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Attacker
    </h4>

    <figure>
        <table>
            <tr>
                <th>&emsp;🔥</th>
                <th>Token</th>
                <th>Mål</th>
                <th>Sida</th>
            </tr>
            @foreach (var attack in Model.Attacks)
            {
                <tr>
                    <td>
                        @(attack.Created.ToFixedFormatDateShortTime())
                    </td>
                    <td>
                        <a href="/show-attack/@(attack.Id)">
                        @(attack.Value)
                        </a>
                    </td>
                    <td>
                        <a href="/show-target/@(attack.TargetId)">
                        @(attack.TargetName)
                        </a>
                    </td>
                    <td>
                        <a href="/show-payload-page/@(attack.PayloadPageId)">
                        @(attack.PageName)
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Attacks.Any())
            {
                <tr>
                    <td colspan="3">
                        Inga
                    </td>
                </tr>
            }
        </table>
    </figure>

</main>
