@page "/remove-email-image/{id:int}"
@model RemoveEmailImageModel
@{
}

@section Meta {
    <title>
        Ta bort bild -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Ta bort bilden:
        @(Model.EmailImage.Name)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.EmailImageId" />

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-email-image/@(Model.CommandModel.EmailImageId)">
            Avbryt
        </a>
    </form>

</main>
