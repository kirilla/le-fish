@page "/show-payload-page/{id:int}"
@model ShowPayloadPageModel
@{
}

@section Meta {
    <title>Fångstsida - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🕸️ Fångstsida: 
        @(Model.PayloadPage.Name)
    </h4>

    <h5>
        URL
    </h5>
    <p class="notice">
        /page/[[token]]
    </p>

    <p>
        @if (Model.CanEditPayloadPage)
        {
            <a class="button" href="/edit-payload-page/@(Model.PayloadPage.Id)">
                Redigera
            </a>
        }

        @if (Model.CanClonePayloadPage)
        {
            <a class="button" href="/clone-payload-page/@(Model.PayloadPage.Id)">
                Klona
            </a>
        }

        @if (Model.CanRemovePayloadPage)
        {
            <a class="button" href="/remove-payload-page/@(Model.PayloadPage.Id)">
                Ta bort
            </a>
        }
    </p>

    <h5>
        HTML
    </h5>
    <pre class="notice">@(Model.PayloadPage.Html)</pre>

    <h5>
        Besök sidan som...
    </h5>

    <ul class="notice">
        @foreach (var token in Model.PageTokens)
        {
            <li>
                🎯
                &thinsp;
                <a href="/page/@(token.Token)">@(token.EmailMessage.EmailTarget.Name), @(token.EmailMessage.EmailTarget.Address)</a>
                &ensp;
                [@(token.Token)]
            </li>
        }

        @if (!Model.PageTokens.Any())
        {
            <li>
                🎯
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

</main>
