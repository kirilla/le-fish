@page "/show-payload-page/{id:int}"
@model ShowPayloadPageModel
@{
}

@section Meta {
    <title>Sida - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        📄 Sida: 
        @(Model.PayloadPage.Name)
    </h4>

    <h5>
        URL
    </h5>
    <p class="notice">
        @(Model.Config.PageUrl ?? "Missing config, see appsettings.json")
    </p>

    <h5>
        HTML
    </h5>
    <pre class="notice">@(Model.PayloadPage.Html)</pre>

    <h5>
        Tokens
    </h5>

    <ul class="notice">
        @foreach (var token in Model.PageKeys)
        {
            <li>
                🍪
                &thinsp;
                @(token.Token)
                    &thinsp;
                <a href="/show-page-key/@(token.Id)">Visa token</a>
                &ensp;
                <a href="/page/@(token.Token)">Besök som</a>
                &thinsp;
                @(token.TargetName), @(token.TargetAddress)
            </li>
        }

        @if (!Model.PageKeys.Any())
        {
            <li>
                🍪
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

    <p>
        @if (Model.CanClonePayloadPage)
        {
            <a class="button" href="/clone-payload-page/@(Model.PayloadPage.Id)">
                Klona
            </a>
        }

        @if (Model.CanEditPayloadPage)
        {
            <a class="button" href="/edit-payload-page/@(Model.PayloadPage.Id)">
                Redigera
            </a>
        }

        @if (Model.CanRemovePayloadPage)
        {
            <a class="button" href="/remove-payload-page/@(Model.PayloadPage.Id)">
                Ta bort
            </a>
        }
    </p>

</main>
