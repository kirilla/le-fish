@page "/clone-payload-page/{id:int}"
@model ClonePayloadPageModel
@{
}

@section Meta {
    <title>
        Klona fångstsida -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Klona fångstsidan:
        @(Model.PayloadPage.Comment)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.PayloadPageId" />

        <label asp-for="CommandModel.PageKey">
            Phishing-nyckel
        </label>
        <input asp-for="CommandModel.PageKey" />

        <label asp-for="CommandModel.Comment">
            Anteckning
        </label>
        <input asp-for="CommandModel.Comment" />

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Klona
        </button>

        <a class="button" href="/show-payload-page/@(Model.PayloadPage.Id)">
            Avbryt
        </a>
    </form>

</main>
