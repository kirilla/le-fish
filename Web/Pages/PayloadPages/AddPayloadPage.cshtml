@page "/add-payload-page"
@model AddPayloadPageModel
@{
}

@section Meta {
    <title>
        Lägg till fångstsida -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Lägg till en fångstsida
    </h4>

    <form method="post">

        <label asp-for="CommandModel.PageKey">
            Phishing-nyckel
        </label>
        <input asp-for="CommandModel.PageKey" />

        <label asp-for="CommandModel.Comment">
            Anteckning
        </label>
        <input asp-for="CommandModel.Comment" />

        <label asp-for="CommandModel.Html">
            HTML
        </label>
        <textarea asp-for="CommandModel.Html" rows="10"></textarea>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Lägg till
        </button>

        <a class="button" href="/show-payload-pages">
            Avbryt
        </a>
    </form>

</main>
