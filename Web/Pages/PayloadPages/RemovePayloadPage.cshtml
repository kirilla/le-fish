@page "/remove-payload-page/{id:int}"
@model RemovePayloadPageModel
@{
}

@section Meta {
    <title>
        Ta bort sida -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Ta bort sidan:
        @(Model.PayloadPage.Name)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.PayloadPageId" />

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-payload-page/@(Model.CommandModel.PayloadPageId)">
            Avbryt
        </a>
    </form>

</main>
