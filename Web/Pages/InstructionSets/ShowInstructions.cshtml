@page "/show-instructions"
@model ShowInstructionsModel
@{
}

@section Meta {
    <title>
        Samlingar av instruktioner -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        ❇️
        Instruktioner
    </h4>

    <div class="notice">
        @if (!Model.InstructionSets.Any())
        {
            <div>
                ✴️
                &thinsp;
                &ndash;
            </div>
        }

        @foreach (var set in Model.InstructionSets)
        {
            <div>
                ✴️
                &thinsp;
                <a href="/show-instruction-set/@(set.Id)">
                    @(set.Name)
                </a>
            </div>

            var instructions = Model.Instructions
                .Where(x => x.InstructionSetId == set.Id)
                .ToList();

            @foreach (var instruction in instructions)
            {
                <div>
                    ❇️
                    &thinsp;
                    <a href="/show-instruction/@(instruction.Id)">@(instruction.Name)</a>
                </div>
            }

            @if (instructions.Any())
            {
                <br />
            }
        }
    </div>

    <p>
        @if (Model.CanAddInstructionSet)
        {
            <a class="button" href="/add-instruction-set">
                Ny samling
            </a>
        }
        
        @if (Model.CanCloneInstructionSet)
        {
            <a class="button" href="/clone-instruction-set">
                Klona samling
            </a>
        }
    </p>

</main>
