@page "/clone-instruction-set/"
@model CloneInstructionSetModel
@{
}

@section Meta {
    <title>
        Klona samling -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        ✴️
        Klona samling
    </h4>

    <form method="post">

        <label asp-for="CommandModel.Id">
            Samling
        </label>

        <select asp-for="CommandModel.Id">
            <option value="">–</option>
            @foreach (var set in Model.InstructionSets)
            {
                <option value="@(set.Id)">
                    @(set.Name)
                </option>
            }
        </select>

        <label asp-for="CommandModel.Name">
            Namn på den nya samlingen
        </label>
        <input asp-for="CommandModel.Name" />

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Skapa
        </button>

        <a class="button" href="/show-instructions">
            Avbryt
        </a>
    </form>

</main>
