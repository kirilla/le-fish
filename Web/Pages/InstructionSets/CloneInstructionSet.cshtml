@page "/clone-instruction-set/{id:int}"
@model CloneInstructionSetModel
@{
}

@section Meta {
    <title>
        Klona samling -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Klona samlingen:
        @(Model.InstructionSet.Name)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.Id" />

        <label asp-for="CommandModel.Name">
            Namn
        </label>
        <input asp-for="CommandModel.Name" />

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Klona
        </button>

        <a class="button" href="/show-instruction-set/@(Model.InstructionSet.Id)">
            Avbryt
        </a>
    </form>

</main>
