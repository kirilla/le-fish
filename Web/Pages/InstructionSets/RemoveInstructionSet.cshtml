@page "/remove-instruction-set/{id:int}"
@model RemoveInstructionSetModel
@{
}

@section Meta {
    <title>
        Ta bort samling -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        ✴️
        @(Model.InstructionSet.Name)
    </h4>

    <h5>
        Vill du ta bort samlingen?
    </h5>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.Id" />

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-instruction-set/@(Model.CommandModel.Id)">
            Avbryt
        </a>
    </form>

</main>
