@page "/show-instruction-sets"
@model ShowInstructionSetsModel
@{
}

@section Meta {
    <title>
        Samlingar av instruktioner -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Instruktioner
    </h4>

    <div class="notice">
        @if (!Model.InstructionSets.Any())
        {
            <div>
                ✴️
                &thinsp;
                &ndash;
            </div>
        }

        @foreach (var set in Model.InstructionSets)
        {
            <div>
                ✴️
                &thinsp;
                <a href="/show-instruction-set/@(set.Id)">
                    @(set.Name)
                </a>
            </div>

            var subset = Model.Instructions
                .Where(x => x.InstructionSetId == set.Id)
                .ToList();

            @foreach (var instruction in subset)
            {
                <div>
                    ❇️
                    &thinsp;
                    <a href="/show-instruction/@(instruction.Id)">@(instruction.Name)</a>
                </div>
            }

            @if (subset.Any())
            {
                <br />
            }
        }
    </div>

    @if (Model.CanAddInstructionSet)
    {
        <p>
            <a class="button" href="/add-instruction-set">
                Ny samling
            </a>
        </p>
    }

</main>
