@page "/send-email-to-target/{id:int}"
@model SendEmailToTargetModel
@{
}

@section Meta {
    <title>
        Skicka meddelande -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Skicka meddelande till 
        @(Model.Target.Name),
        @(Model.Target.Address)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.TargetId" />

        <label asp-for="CommandModel.EmailAccountId">
            Avsändare
        </label>

        <select asp-for="CommandModel.EmailAccountId">
            <option value="">–</option>
            @foreach (var target in Model.EmailAccounts)
            {
                <option value="@(target.Id)">
                    @(target.FromName), @(target.FromAddress)
                </option>
            }
        </select>

        <label asp-for="CommandModel.EmailTemplateId">
            Epostmall
        </label>

        <select asp-for="CommandModel.EmailTemplateId">
            <option value="">–</option>
            @foreach (var target in Model.EmailTemplates)
            {
                <option value="@(target.Id)">
                    @(target.Subject)
                </option>
            }
        </select>

        <label asp-for="CommandModel.WebPageId">
            Länk till sida
        </label>

        <select asp-for="CommandModel.WebPageId">
            <option value="">–</option>
            @foreach (var page in Model.PayloadPages)
            {
                <option value="@(page.Id)">
                    @(page.Name)
                </option>
            }
        </select>

        <label asp-for="CommandModel.PageScriptId">
            Skript på sidan
        </label>

        <select asp-for="CommandModel.PageScriptId">
            <option value="">–</option>
            @foreach (var script in Model.PageScripts)
            {
                <option value="@(script.Id)">
                    @(script.Name)
                </option>
            }
        </select>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Skicka
        </button>

        <a class="button" href="/show-target/@(Model.Target.Id)">
            Avbryt
        </a>
    </form>

</main>
