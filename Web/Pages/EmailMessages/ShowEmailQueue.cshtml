@page "/show-email-queue"
@model ShowEmailQueueModel
@{
}

@section Meta {
    <title>
        Utkorg -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Utkorg
    </h4>

    <h5>
        Väntande
    </h5>

    <figure>
        <table>
            <tr>
                <th>När</th>
                <th>Namn</th>
                <th>Adress</th>
                <th>Ämne</th>
            </tr>
            @foreach (var email in Model.NotSentEmails)
            {
                <tr>
                    <td>
                        <a href="/show-email/@(email.Id)">
                            @(email.Created.ToFixedFormatDateShortTime())
                        </a>
                    </td>
                    <td>
                        @(email.ToName)
                    </td>
                    <td>
                        @(email.ToAddress)
                    </td>
                    <td>
                        @(email.Subject)
                    </td>
                </tr>
            }
        </table>
    </figure>

    @if (!Model.NotSentEmails.Any())
    {
        <p>
            inga
        </p>
    }

    <h5>
        Misslyckat
    </h5>

    <figure>
        <table>
            <tr>
                <th>När</th>
                <th>Namn</th>
                <th>Adress</th>
                <th>Ämne</th>
            </tr>
            @foreach (var email in Model.FailedEmails)
            {
                <tr>
                    <td>
                        <a href="/show-email/@(email.Id)">
                            @(email.Created.ToFixedFormatDateShortTime())
                        </a>
                    </td>
                    <td>
                        @(email.ToName)
                    </td>
                    <td>
                        @(email.ToAddress)
                    </td>
                    <td>
                        @(email.Subject)
                    </td>
                </tr>
            }
        </table>
    </figure>

    @if (!Model.FailedEmails.Any())
    {
        <p>
            inga
        </p>
    }

    <h5>
        Skickat
    </h5>

    <figure>
        <table>
            <tr>
                <th>När</th>
                <th>Namn</th>
                <th>Adress</th>
                <th>Ämne</th>
            </tr>
            @foreach (var email in Model.SentEmails)
            {
                <tr>
                    <td>
                        <a href="/show-email/@(email.Id)">
                            @(email.Created.ToFixedFormatDateShortTime())
                        </a>
                    </td>
                    <td>
                        @(email.ToName)
                    </td>
                    <td>
                        @(email.ToAddress)
                    </td>
                    <td>
                        @(email.Subject)
                    </td>
                </tr>
            }
        </table>
    </figure>

    @if (!Model.SentEmails.Any())
    {
        <p>
            inga
        </p>
    }

    <p>
        <a class="button" href="/remove-email-messages">
            Ta bort epostmeddelanden
        </a>
    </p>

</main>
