@page "/show-email-target/{id:int}"
@model ShowEmailTargetModel
@{
}

@section Meta {
    <title>Målkonto - @(Model.EmailTarget.Name) - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🎯
        @(Model.EmailTarget.Name)
    </h4>

    <div class="notice">
        <ul>
            <li>
                @(Model.EmailTarget.Address)
            </li>
        </ul>
    </div>

    <p>
        @if (Model.CanEditTarget)
        {
            <a class="button" href="/edit-email-target/@(Model.EmailTarget.Id)">
                Redigera
            </a>
        }

        @if (Model.CanRemoveTarget)
        {
            <a class="button" href="/remove-email-target/@(Model.EmailTarget.Id)">
                Ta bort
            </a>
        }
    </p>

    <h5>Skickade meddelanden</h5>

    <ul class="notice">
        @foreach (var header in Model.EmailHeaders)
        {
            <li>
                📩
                &thinsp;
                <a href="/show-email/@(header.Id)">@(header.Subject)</a>
                &ensp;
                @(header.Created.ToFixedFormatDateShortTime())
            </li>
        }

        @if (!Model.EmailHeaders.Any())
        {
            <li>
                📩
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

    <p>
        @if (Model.CanSendEmailToTargetCommand)
        {
            <a class="button" href="/send-email-to-target/@(Model.EmailTarget.Id)">
                Skicka meddelande
            </a>
        }
    </p>

    <h4>
        Tokens
    </h4>

    <ul class="notice">
        @foreach (var token in Model.PageTokens)
        {
            <li>
                🍪
                &thinsp;
                <a href="/show-page-token/@(token.Id)">@(token.Token)</a>
                &thinsp;
                avsedd för
                &thinsp;
                🕸️
                <a href="/show-payload-page/@(token.PayloadPageId)">@(token.PageName)</a>
                &ensp;
                @if (Model.CanUploadDataDump)
                {
                    <span>
                        &ensp;
                        <a href="/upload/@(token.Token)">
                            Ladda upp data
                        </a>
                    </span>
                }
            </li>
        }

        @if (!Model.PageTokens.Any())
        {
            <li>
                    🍪
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

    <h4>
        Sidbesök
    </h4>

    <figure>
        <table>
            <tr>
                <th>&emsp;🙋</th>
                <th>Sida</th>
                <th>IP-nummer</th>
                <th>UserAgent</th>
            </tr>
            @foreach (var visit in Model.PageVisits)
            {
                <tr>
                    <td>
                        <a href="/show-page-visit/@(visit.Id)">
                            @(visit.Created.ToFixedFormatDateShortTime())
                        </a>
                    </td>
                    <td>
                        <a href="/show-payload-page/@(visit.PayloadPageId)">
                            @(visit.PageName ?? "null")
                        </a>
                    </td>
                    <td>
                        @(visit.IpAddress)
                    </td>
                    <td>
                        @(visit.UserAgent)
                    </td>
                </tr>
            }
            @if (!Model.PageVisits.Any())
            {
                <tr>
                    <td colspan="3">
                        Inga
                    </td>
                </tr>
            }
        </table>
    </figure>

</main>
