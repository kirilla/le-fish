@page "/show-email-target/{id:int}"
@model ShowEmailTargetModel
@{
}

@section Meta {
    <title>Mål - @(Model.EmailTarget.Name) - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🎯
        @(Model.EmailTarget.Name)
    </h4>

    <div class="notice">
        <ul>
            <li>
                @(Model.EmailTarget.Address)
            </li>
        </ul>
    </div>

    <p>
        @if (Model.CanEditTarget)
        {
            <a class="button" href="/edit-email-target/@(Model.EmailTarget.Id)">
                Redigera
            </a>
        }

        @if (Model.CanRemoveTarget)
        {
            <a class="button" href="/remove-email-target/@(Model.EmailTarget.Id)">
                Ta bort
            </a>
        }
    </p>

    <h5>
        Attack
    </h5>

    <div class="notice">
        @foreach (var attack in Model.Attacks)
        {
            <div>
                <span>
                    🔥
                    &thinsp;
                    <a href="/show-attack/@(attack.Id)">@(attack.Value)</a>
                    &ensp;
                    <span class="muted">
                        @(attack.Created.ToFixedFormatDateShortTime())
                    </span>
                </span>
            </div>
        }

        @if (!Model.Attacks.Any())
        {
            <div>
                🔥
                &thinsp;
                &ndash;
            </div>
        }
    </div>

    <p>
        @if (Model.CanSendEmailToTarget)
        {
            <a class="button" href="/send-email-to-target/@(Model.EmailTarget.Id)">
                Skicka meddelande
            </a>
        }
    </p>

</main>
