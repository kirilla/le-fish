@page "/show-email-target/{id:int}"
@model ShowEmailTargetModel
@{
}

@section Meta {
    <title>Målkonto - @(Model.EmailTarget.Name) - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🎯
        @(Model.EmailTarget.Name)
    </h4>

    <div class="notice">
        <ul>
            <li>
                @(Model.EmailTarget.Address)
            </li>
        </ul>
    </div>

    <p>
        @if (Model.CanSendEmailToTarget)
        {
            <a class="button" href="/send-email-to-target/@(Model.EmailTarget.Id)">
                Skicka meddelande
            </a>
        }
    </p>

    <h5>
        Attack
    </h5>

    <div class="notice">
        <div>
            🎯
            &thinsp;
            <a href="/show-email-target/@(Model.EmailTarget.Id)">@(Model.EmailTarget.Name)</a>
            &thinsp;
            <span class="muted">
                @(Model.EmailTarget.Address)
            </span>
        </div>

        @foreach (var message in Model.EmailMessages.Where(x => x.EmailTargetId == Model.EmailTarget.Id))
        {
            <div style="padding-left:1.5em;">
                <span>
                    📩
                    &thinsp;
                    <a href="/show-email/@(message.Id)">@(message.Subject)</a>
                    &thinsp;
                    <span class="muted">
                        skickat @(message.Sent.ToFixedFormatDateShortTime())
                    </span>
                </span>

                @foreach (var token in Model.PageTokens.Where(x => x.EmailMessageId == message.Id))
                {
                    <div style="padding-left:1.5em;">
                        <div>
                            🍪
                            &thinsp;
                            <a href="/show-page-token/@(token.Id)">@(token.Token)</a>
                        </div>

                        @foreach (var visit in Model.Visits.Where(x => x.PageTokenId == token.Id))
                        {
                            if (visit.VisitKind == VisitKind.Page)
                            {
                                <div style="padding-left:1.5em;">
                                    📄
                                    &thinsp;
                                    <a href="/show-payload-page/@(visit.PayloadPageId)">@(visit.PageName)</a>
                                    &thinsp;
                                    <span class="muted">
                                        besökt @(visit.Created.ToFixedFormatDateShortTime())
                                    </span>
                                </div>
                            }

                            if (visit.VisitKind == VisitKind.Script)
                            {
                                <div style="padding-left:1.5em;">
                                    📜
                                    &thinsp;
                                    <a href="/show-payload-script/@(visit.PayloadScriptId)">@(visit.ScriptName)</a>
                                    &thinsp;
                                    <span class="muted">
                                        besökt @(visit.Created.ToFixedFormatDateShortTime())
                                    </span>
                                </div>
                            }
                        }

                        @if (!Model.Visits.Any(x => x.PageTokenId == token.Id))
                        {
                            <div style="padding-left:1.5em;">
                                📄
                                &thinsp;
                                &ndash;
                            </div>
                        }

                        @if (Model.CanUploadDataDump)
                        {
                            <div style="padding-left:1.5em;">
                                💉
                                &thinsp;
                                <a href="/upload/@(token.Token)">
                                    Ladda upp data
                                </a>
                            </div>
                        }
                    </div>
                }

                @if (!Model.PageTokens.Any(x => x.EmailMessageId == message.Id))
                {
                    <div style="padding-left:1.5em;">
                        🍪
                        &thinsp;
                        &ndash;
                    </div>
                }
            </div>
            <br />
        }

        @if (!Model.EmailMessages.Any(x => x.EmailTargetId == Model.EmailTarget.Id))
        {
            <div style="padding-left:1.5em;">
                📩
                &thinsp;
                &ndash;
            </div>
        }
    </div>

    @if (Model.UserAgents.Any())
    {
        <h5>
            Agent
        </h5>

        <ul class="notice">
            @foreach (var agent in Model.UserAgents)
            {
                <li>
                @(agent)
                </li>
            }
        </ul>
    }

    @if (Model.IpAddresses.Any())
    {
        <h5>
            IP-nummer
        </h5>

        <ul class="notice">
            @foreach (var address in Model.IpAddresses)
            {
                <li>
                @(address)
                </li>
            }
        </ul>
    }

    <p>
        @if (Model.CanEditTarget)
        {
            <a class="button" href="/edit-email-target/@(Model.EmailTarget.Id)">
                Redigera
            </a>
        }

        @if (Model.CanRemoveTarget)
        {
            <a class="button" href="/remove-email-target/@(Model.EmailTarget.Id)">
                Ta bort
            </a>
        }
    </p>

</main>
