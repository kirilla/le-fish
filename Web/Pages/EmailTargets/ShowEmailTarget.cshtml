@page "/show-email-target/{id:int}"
@model ShowEmailTargetModel
@{
}

@section Meta {
    <title>Mål - @(Model.EmailTarget.Name) - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🎯
        @(Model.EmailTarget.Name)
    </h4>

    <div class="notice">
        <ul>
            <li>
                @(Model.EmailTarget.Address)
            </li>
        </ul>
    </div>

    <p>
        @if (Model.CanEditTarget)
        {
            <a class="button" href="/edit-email-target/@(Model.EmailTarget.Id)">
                Redigera
            </a>
        }

        @if (Model.CanRemoveTarget)
        {
            <a class="button" href="/remove-email-target/@(Model.EmailTarget.Id)">
                Ta bort
            </a>
        }
    </p>

    <h5>
        Attack
    </h5>

    <div class="notice">
        @foreach (var key in Model.PageKeys)
        {
            <div>
                <span>
                    🔑
                    &thinsp;
                    <a href="/show-page-key/@(key.Id)">@(key.Value)</a>
                </span>

                @foreach (var message in Model.EmailMessages
                    .Where(x => x.PageKeyId == key.Id))
                {
                    <div style="padding-left:1.5em;">
                        📩
                        &thinsp;
                        <a href="/show-email/@(message.Id)">@(message.Subject)</a>
                        &thinsp;
                        <span class="muted">
                            skickat @(message.Sent.ToFixedFormatDateShortTime())
                        </span>
                    </div>
                }

                @if (!Model.EmailMessages
                    .Any(x => x.PageKeyId == key.Id))
                {
                    <div style="padding-left:1.5em;">
                        📩
                        &thinsp;
                        &ndash;
                    </div>
                }
            </div>
        }

        @if (!Model.PageKeys.Any())
        {
            <div>
                🔑
                &thinsp;
                &ndash;
            </div>
        }
    </div>

    <p>
        @if (Model.CanSendEmailToTarget)
        {
            <a class="button" href="/send-email-to-target/@(Model.EmailTarget.Id)">
                Skicka meddelande
            </a>
        }
    </p>

</main>
