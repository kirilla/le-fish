@page "/edit-target-instruction/{id:int}"
@model EditTargetInstructionModel
@{
}

@section Meta {
    <title>
        Redigera instruktion -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Redigera instruktionen:
        @(Model.TargetInstruction.Name)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.TargetInstructionId" />

        <label asp-for="CommandModel.Name">
            Namn
        </label>
        <input asp-for="CommandModel.Name" />

        <label asp-for="CommandModel.Script">
            Skript
        </label>
        <textarea asp-for="CommandModel.Script" rows="10"></textarea>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Spara
        </button>

        <a class="button" href="/show-target-instruction/@(Model.TargetInstruction.Id)">
            Avbryt
        </a>
    </form>

</main>
