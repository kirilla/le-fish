@page "/select-target-instruction/{id:int}"
@model SelectTargetInstructionModel
@{
}

@section Meta {
    <title>
        Lägg till instruktion -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Lägg till en instruktion
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.PageKeyId" />

        <label asp-for="CommandModel.InstructionId">
            Instruktion
        </label>

        <select asp-for="CommandModel.InstructionId">
            <option value="">–</option>
            @foreach (var instruction in Model.Instructions)
            {
                <option value="@(instruction.Id)">
                    @(instruction.Name)
                </option>
            }
        </select>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Lägg till
        </button>

        <a class="button" href="/show-page-key/@(Model.PageKey.Id)">
            Avbryt
        </a>
    </form>

</main>
