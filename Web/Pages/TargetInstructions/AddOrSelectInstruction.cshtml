@page "/add-or-select-instruction/{id:int}"
@model AddOrSelectInstructionModel
@{
}

@section Meta {
    <title>
        Lägg till instruktion -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Lägg till en instruktion
    </h4>
    
    <p>
        <a class="button" href="/select-target-instruction/@(Model.Attack.Id)">
            Välj befintlig
        </a>

        <a class="button" href="/add-target-instruction/@(Model.Attack.Id)">
            Skapa ny
        </a>
    </p>

    <p>
        <a class="button" href="/show-attack/@(Model.Attack.Id)">
            Avbryt
        </a>
    </p>

</main>
