@page "/remove-instruction/{id:int}"
@model RemoveInstructionModel
@{
}

@section Meta {
    <title>
        Ta bort instruktion -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        ✴️
        <a href="/show-instruction-set/@(Model.InstructionSet.Id)">
            @(Model.InstructionSet.Name)
        </a>
        <br />
        ❇️
        @(Model.Instruction.Name)
    </h4>

    <h5>
        Vill du ta bort instruktionen?
    </h5>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.InstructionId" />

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-instruction/@(Model.CommandModel.InstructionId)">
            Avbryt
        </a>
    </form>

</main>
