@page "/show-instruction/{id:int}"
@model ShowInstructionModel
@{
}

@section Meta {
    <title>Instruktion - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        ✴️
        <a href="/show-instruction-set/@(Model.InstructionSet.Id)">
            @(Model.InstructionSet.Name)</a>
        <br />
        ❇️
        @(Model.Instruction.Name)
    </h4>

    <h5>
        Skript
    </h5>
    <pre class="notice">@(Model.Instruction.Script)</pre>

    <p>
        @if (Model.CanEditInstruction)
        {
            <a class="button" href="/edit-instruction/@(Model.Instruction.Id)">
                Redigera
            </a>
        }

        @if (Model.CanRemoveInstruction)
        {
            <a class="button" href="/remove-instruction/@(Model.Instruction.Id)">
                Ta bort
            </a>
        }
    </p>

</main>
