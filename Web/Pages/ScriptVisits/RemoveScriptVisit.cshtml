@page "/remove-script-visit/{id:int}"
@model RemoveScriptVisitModel
@{
}

@section Meta {
    <title>
        Ta bort skriptbesök -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Ta bort skriptbesöket:<br />
        @(Model.ScriptVisit.TargetName)
        @(Model.ScriptVisit.TargetAddress)<br />
        @(Model.ScriptVisit.PageName)<br />
        @(Model.ScriptVisit.Created.ToFixedFormatDateShortTime())
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.ScriptVisitId" />

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-script-visit/@(Model.CommandModel.ScriptVisitId)">
            Avbryt
        </a>
    </form>

</main>
