@page "/remove-script-visits"
@model RemoveScriptVisitsModel
@{
}

@section Meta {
    <title>
        Ta bort skriptbesök -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Ta bort skriptbesök
    </h4>

    <form method="post">

        <label asp-for="CommandModel.EmailTargetId">
            Målkonto
        </label>

        <select asp-for="CommandModel.EmailTargetId">
            <option value="">–</option>
            @foreach (var target in Model.EmailTargets)
            {
                <option value="@(target.Id)">
                    @(target.Name), @(target.Address)
                </option>
            }
        </select>

        <p>
            Lämna tomt för att ta bort alla.
        </p>

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-script-visits">
            Avbryt
        </a>

    </form>

</main>
