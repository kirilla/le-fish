@page "/company/edit/{id:int}"
@model EditCompanyModel
@{
}

@section Meta {
    <title>
        Redigera företag -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Redigera företaget:
        @(Model.Company.Name)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.CompanyId" />

        <label asp-for="CommandModel.Name">
            Namn
        </label>
        <input asp-for="CommandModel.Name" />

        <div asp-validation-summary="All"></div>

        <p class="notice">
            Vänligen säkerställ att det fortfarande är 
            <u>samma företag</u>.
        </p>

        <button type="submit">
            Spara
        </button>

        <a class="button" href="/show-company/@(Model.Company.Id)">
            Avbryt
        </a>
    </form>

</main>
