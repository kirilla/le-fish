@page "/edit-data-result/{id:int}"
@model EditDataResultModel
@{
}

@section Meta {
    <title>
        Redigera data -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Redigera data
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.Id" />

        <label asp-for="CommandModel.JsonData">
            Data
        </label>
        <input asp-for="CommandModel.JsonData" />

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Spara
        </button>

        <a class="button" href="/show-data-result/@(Model.DataResult.Id)">
            Avbryt
        </a>
    </form>

</main>
