@page "/show-data-results"
@model ShowDataResultsModel
@{
}

@section Meta {
    <title>
        Avlämnade data -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Avlämnade data
    </h4>

    <div class="notice">

        <ul>
            @foreach (var result in Model.DataResults)
            {
                <li>
                    📦
                    &thinsp;
                    <a href="/show-data-result/@(result.Id)">
                        @(result.Created.ToFixedFormatDateShortTime())
                    </a>
                </li>
            }

            @if (!Model.DataResults.Any())
            {
                <li>
                    📦
                    &thinsp;
                    &ndash;
                </li>
            }
        </ul>

    </div>

    <p>
        <a class="button" href="/remove-data-results">
            Ta bort
        </a>
    </p>

</main>
