@page "/edit-target/{id:int}"
@model EditTargetModel
@{
}

@section Meta {
    <title>
        Redigera målkonto -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Redigera målkonto:
        @(Model.Target.Name)
        @(Model.Target.Address)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.Id" />

        <label asp-for="CommandModel.Name">
            Namn
        </label>
        <input asp-for="CommandModel.Name" />

        <label asp-for="CommandModel.Address">
            Epostadress
        </label>
        <input asp-for="CommandModel.Address" />

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Spara
        </button>

        <a class="button" href="/show-target/@(Model.Target.Id)">
            Avbryt
        </a>
    </form>

</main>
