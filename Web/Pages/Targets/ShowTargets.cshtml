@page "/show-targets"
@model ShowTargetsModel
@{
}

@section Meta {
    <title>
        Mål -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Mål
    </h4>

    <div class="notice">

        <ul>
            @foreach (var target in Model.Targets)
            {
                <li>
                    🎯
                    &thinsp;
                    <a href="/show-target/@(target.Id)">@(target.Name)</a>
                    &ensp;
                    @(target.Address)
                </li>
            }

            @if (!Model.Targets.Any())
            {
                <li>
                    🎯
                    &thinsp;
                    &ndash;
                </li>
            }
        </ul>

    </div>

    @if (Model.CanAddTarget)
    {
        <p>
            <a class="button" href="/add-target">
                Lägg till
            </a>
        </p>
    }

</main>
