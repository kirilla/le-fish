@page "/show-page-key/{id:int}"
@model ShowPageKeyModel
@{
}

@section Meta {
    <title>Nyckel - @(Model.PageKey.Value) - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🎯
        @(Model.PageKey.TargetName)<br />
        🔑
        @(Model.PageKey.Value)
    </h4>

    <ul class="notice">
        <li>
            📧
            &thinsp;
            <a href="/show-email/@(Model.PageKey.EmailMessageId)">
                @(Model.PageKey.EmailMessageSubject)</a>
            &ensp;
            <span class="muted">
                @(Model.PageKey.TargetAddress)
            </span>
        </li>
        <li>
            📄
            &thinsp;
            <a href="/show-payload-page/@(Model.PageKey.PayloadPageId)">
                @(Model.PageKey.PageName)
            </a>
        </li>
        <li>
            📜
            &thinsp;
            <a href="/show-payload-script/@(Model.PageKey.PayloadScriptId)">
                @(Model.PageKey.ScriptName)
            </a>
        </li>
    </ul>

    <h5>
        Instruktioner
    </h5>

    <ul class="notice">
        @foreach (var instruction in Model.QueuedInstructions)
        {
            <li>
                ❇️
                &thinsp;
                <a href="/show-instruction/@(instruction.InstructionId)">
                    @(instruction.Name)
                </a>
            </li>
        }
        @if (!Model.QueuedInstructions.Any())
        {
            <li>
                ❇️
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

    <h5>
        Sidbesök
    </h5>

    <figure>
        <table>
            <tr>
                <th>&emsp;🙋</th>
                <th>IP-nummer</th>
                <th>UserAgent</th>
            </tr>
            @foreach (var visit in Model.PageVisits)
            {
                <tr>
                    <td>
                        <a href="/show-page-visit/@(visit.Id)">
                            @(visit.Created.ToFixedFormatDateShortTime())
                        </a>
                    </td>
                    <td>
                        @(visit.IpAddress)
                    </td>
                    <td>
                        @(visit.UserAgent)
                    </td>
                </tr>
            }
            @if (!Model.PageVisits.Any())
            {
                <tr>
                    <td colspan="3">
                        Inga
                    </td>
                </tr>
            }
        </table>
    </figure>

    <br />

    <h5>
        Skriptnedladdningar
    </h5>

    <figure>
        <table>
            <tr>
                <th>&emsp;🙋</th>
                <th>IP-nummer</th>
                <th>UserAgent</th>
            </tr>
            @foreach (var visit in Model.ScriptVisits)
            {
                <tr>
                    <td>
                        <a href="/show-script-visit/@(visit.Id)">
                            @(visit.Created.ToFixedFormatDateShortTime())
                        </a>
                    </td>
                    <td>
                        @(visit.IpAddress)
                    </td>
                    <td>
                        @(visit.UserAgent)
                    </td>
                </tr>
            }
            @if (!Model.ScriptVisits.Any())
            {
                <tr>
                    <td colspan="3">
                        Inga
                    </td>
                </tr>
            }
        </table>
    </figure>

    <br />

    @if (Model.UserAgents.Any())
    {
        <h5>
            Agent
        </h5>

        <ul class="notice">
            @foreach (var agent in Model.UserAgents)
            {
                <li>
                    @(agent)
                </li>
            }
        </ul>
    }

    @if (Model.IpAddresses.Any())
    {
        <h5>
            IP-nummer
        </h5>

        <ul class="notice">
            @foreach (var address in Model.IpAddresses)
            {
                <li>
                    @(address)
                </li>
            }
        </ul>
    }

    <h5>Ladda upp data</h5>

    <div class="notice">
        💉
        &thinsp;
        <a href="/upload/@(Model.PageKey.Value)">
            Ladda upp data
        </a>
    </div>

</main>
