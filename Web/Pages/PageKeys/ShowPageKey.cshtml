@page "/show-page-key/{id:int}"
@model ShowPageKeyModel
@{
}

@section Meta {
    <title>Nyckel - @(Model.PageKey.Value) - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        🔑
        @(Model.PageKey.Value)
    </h4>

    <ul class="notice">
        <li>
            🎯
            &thinsp;
            <a href="/show-email-target/@(Model.PageKey.EmailTargetId)">
                "@(Model.PageKey.TargetName)"
                &lt;@(Model.PageKey.TargetAddress)&gt;
            </a>
        </li>
        <li>
            📧
            &thinsp;
            <a href="/show-email/@(Model.PageKey.EmailMessageId)">
                @(Model.PageKey.EmailMessageSubject)
            </a>
        </li>
        <li>
            📄
            &thinsp;
            <a href="/show-payload-page/@(Model.PageKey.PayloadPageId)">
                @(Model.PageKey.PageName)
            </a>
        </li>
        <li>
            📜
            &thinsp;
            <a href="/show-payload-script/@(Model.PageKey.PayloadScriptId)">
                @(Model.PageKey.ScriptName)
            </a>
        </li>
    </ul>

    <p class="notice">
        🥸
        &thinsp;
        <a href="/page/@(Model.PageKey.Value)">
            Besök sidan som @(Model.PageKey.TargetName)</a>
    </p>

    <h5>
        Sidbesök
    </h5>

    <figure>
        <table>
            <tr>
                <th>&emsp;🙋</th>
                <th>IP-nummer</th>
                <th>UserAgent</th>
            </tr>
            @foreach (var visit in Model.PageVisits)
            {
                <tr>
                    <td>
                        @(visit.Created.ToFixedFormatDateShortTime())
                    </td>
                    <td>
                        @(visit.IpAddress)
                    </td>
                    <td>
                        @(visit.UserAgent)
                    </td>
                </tr>
            }
            @if (!Model.PageVisits.Any())
            {
                <tr>
                    <td colspan="3">
                        Inga
                    </td>
                </tr>
            }
        </table>
    </figure>

    <h5>
        Köade instruktioner
    </h5>

    <ul class="notice">
        @foreach (var instruction in Model.QueuedInstructions)
        {
            <li>
                ❇️
                &thinsp;
                <a href="/show-instruction/@(instruction.InstructionId)">
                    @(instruction.Name)
                </a>
                &ensp;
                @(instruction.Created.ToFixedFormatDateShortTime())
            </li>
        }
        @if (!Model.QueuedInstructions.Any())
        {
            <li>
                ❇️
                &thinsp;
                &ndash;
            </li>
        }
    </ul>

</main>
