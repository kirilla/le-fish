@page "/show-visits"
@model ShowVisitsModel
@{
}

@section Meta {
    <title>
        Sidbesök -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Sidbesök
    </h4>

    <div class="notice">

        <ul>
            @foreach (var visit in Model.Visits)
            {
                <li>
                    🛎️
                    &thinsp;
                    <a href="/show-visit/@(visit.Id)">
                        @(visit.TargetAddress)
                        &thinsp;
                        @(visit.PageName)
                        &thinsp;
                        @(visit.Created.ToFixedFormatDateShortTime())
                    </a>
                </li>
            }

            @if (!Model.Visits.Any())
            {
                <li>
                    🛎️
                    &thinsp;
                    &ndash;
                </li>
            }
        </ul>

    </div>

    <p>
        <a class="button" href="/remove-visits">
            Ta bort sidbesök
        </a>
    </p>

</main>
