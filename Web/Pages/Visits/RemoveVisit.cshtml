@page "/remove-visit/{id:int}"
@model RemoveVisitModel
@{
}

@section Meta {
    <title>
        Ta bort sidbesök -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Ta bort sidbesöket:<br />
        @(Model.Visit.TargetName)
        @(Model.Visit.TargetAddress)<br />
        @(Model.Visit.PageName)<br />
        @(Model.Visit.Created.ToFixedFormatDateShortTime())
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.VisitId" />

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-visit/@(Model.Visit.Id)">
            Avbryt
        </a>
    </form>

</main>
