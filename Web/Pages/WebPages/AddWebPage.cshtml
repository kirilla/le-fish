@page "/add-web-page"
@model AddWebPageModel
@{
}

@section Meta {
    <title>
        Lägg till sida -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Lägg till en sida
    </h4>

    <form method="post">

        <label asp-for="CommandModel.Name">
            Namn
        </label>
        <input asp-for="CommandModel.Name" />

        <label asp-for="CommandModel.Html">
            HTML
        </label>
        <textarea asp-for="CommandModel.Html" rows="15"></textarea>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Lägg till
        </button>

        <a class="button" href="/show-web-pages">
            Avbryt
        </a>
    </form>

</main>
