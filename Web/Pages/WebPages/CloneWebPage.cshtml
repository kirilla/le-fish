@page "/clone-payload-page/{id:int}"
@model ClonePayloadPageModel
@{
}

@section Meta {
    <title>
        Klona sida -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Klona sidan:
        @(Model.PayloadPage.Name)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.PayloadPageId" />

        <label asp-for="CommandModel.Name">
            Namn
        </label>
        <input asp-for="CommandModel.Name" />

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Klona
        </button>

        <a class="button" href="/show-payload-page/@(Model.PayloadPage.Id)">
            Avbryt
        </a>
    </form>

</main>
