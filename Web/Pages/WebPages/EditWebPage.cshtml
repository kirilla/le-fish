@page "/edit-web-page/{id:int}"
@model EditWebPageModel
@{
}

@section Meta {
    <title>
        Redigera sida -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Redigera sidan:
        @(Model.WebPage.Name)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.Id" />

        <label asp-for="CommandModel.Name">
            Namn
        </label>
        <input asp-for="CommandModel.Name" />

        <label asp-for="CommandModel.Html">
            HTML
        </label>
        <textarea asp-for="CommandModel.Html" rows="10"></textarea>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Spara
        </button>

        <a class="button" href="/show-web-page/@(Model.WebPage.Id)">
            Avbryt
        </a>
    </form>

</main>
