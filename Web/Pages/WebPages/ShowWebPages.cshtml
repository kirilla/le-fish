@page "/show-payload-pages"
@model ShowWebPagesModel
@{
}

@section Meta {
    <title>
        Sidor -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Sidor
    </h4>

    <div class="notice">

        <ul>
            @foreach (var page in Model.WebPages)
            {
                <li>
                    📄
                    &thinsp;
                    <a href="/show-payload-page/@(page.Id)">@(page.Name)</a>
                </li>
            }

            @if (!Model.WebPages.Any())
            {
                <li>
                    📄
                    &thinsp;
                    &ndash;
                </li>
            }
        </ul>

    </div>

    @if (Model.CanAddWebPage)
    {
        <p>
            <a class="button" href="/add-payload-page">
                Lägg till en sida
            </a>
        </p>
    }

</main>
