@page "/show-web-page/{id:int}"
@model ShowWebPageModel
@{
}

@section Meta {
    <title>Sida - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        📄 Sida: 
        @(Model.WebPage.Name)
    </h4>

    <h5>
        HTML
    </h5>
    <pre class="notice">@(Model.WebPage.Html)</pre>

    <p>
        @if (Model.CanCloneWebPage)
        {
            <a class="button" href="/clone-web-page/@(Model.WebPage.Id)">
                Klona
            </a>
        }

        @if (Model.CanEditWebPage)
        {
            <a class="button" href="/edit-web-page/@(Model.WebPage.Id)">
                Redigera
            </a>
        }

        @if (Model.CanRemoveWebPage)
        {
            <a class="button" href="/remove-web-page/@(Model.WebPage.Id)">
                Ta bort
            </a>
        }
    </p>

</main>
