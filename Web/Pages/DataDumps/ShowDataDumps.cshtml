@page "/show-data-dumps"
@model ShowDataDumpsModel
@{
}

@section Meta {
    <title>
        Data -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Data
    </h4>

    <div class="notice">

        <ul>
            @foreach (var target in Model.DataDumps)
            {
                <li>
                    🎯
                    &thinsp;
                    <a href="/show-email-target/@(target.Id)">
                        @(target.Name)
                    </a>
                    &ensp;
                    @* @(target.Address) *@
                </li>
            }

            @if (!Model.DataDumps.Any())
            {
                <li>
                    🎯
                    &thinsp;
                    &ndash;
                </li>
            }
        </ul>

    </div>

    @if (Model.CanAddTarget)
    {
        <p>
            <a class="button" href="/upload-data-dump">
                Ladda upp data
            </a>
        </p>
    }

</main>
