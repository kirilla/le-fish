@page "/show-data-dumps"
@model ShowDataDumpsModel
@{
}

@section Meta {
    <title>
        Data -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Data
    </h4>

    <div class="notice">

        <ul>
            @foreach (var dump in Model.DataDumps)
            {
                <li>
                    🎯
                    &thinsp;
                    <a href="/show-data-dump/@(dump.Id)">
                        @(dump.Name)
                    </a>
                    &ensp;
                    @(dump.Created.ToFixedFormatDateShortTime())
                </li>
            }

            @if (!Model.DataDumps.Any())
            {
                <li>
                    🎯
                    &thinsp;
                    &ndash;
                </li>
            }
        </ul>

    </div>

</main>
