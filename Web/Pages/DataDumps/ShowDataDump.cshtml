@page "/show-data-dump/{id:int}"
@model ShowDataDumpModel
@{
}

@section Meta {
    <title>Bilaga - @(Model.DataDump.Name) - @(Branding.WebsiteTitle)</title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>

    <h4>
        Bilaga:
        @(Model.DataDump.Name)
    </h4>

    <div class="notice">
        <ul>
            <li>
                Filnamn: @(Model.DataDump.Name)
            </li>
            <li>
                Filtyp: @(Model.DataDump.ContentType)
            </li>
        </ul>
        <p>
            <img src="/serve-data-dump/@(Model.DataDump.Id)" />
        </p>
    </div>

    <p>
        @if (Model.CanEditDataDump)
        {
            <a class="button" href="/edit-data-dump/@(Model.DataDump.Id)">
                Redigera
            </a>
        }

        @if (Model.CanRemoveDataDump)
        {
            <a class="button" href="/remove-data-dump/@(Model.DataDump.Id)">
                Ta bort bilagan
            </a>
        }
    </p>

</main>
