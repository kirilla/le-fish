@page "/upload-data-dump/{id:int}"
@model UploadDataDumpModel
@{
}

@section Meta {
    <title>
        Ladda upp bilaga -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Ladda upp bilaga till målkontot:<br />
        @(Model.EmailTarget.Name)
    </h4>

    <div class="notice">

        <form method="post" enctype="multipart/form-data">

            @* <label>Bilaga att ladda upp</label> *@

            <input type="file" asp-for="UploadedFile" />

            @* <span asp-validation-for="UploadedFile"></span> *@

            <div asp-validation-summary="All"></div>

            <button type="submit">Ladda upp</button>
        </form>

        <a class="button" href="/show-data-dump/@(Model.EmailTarget.Id)">
            Avbryt
        </a>

    </div>

</main>
