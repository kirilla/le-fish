@page "/remove-data-dump/{id:int}"
@model RemoveDataDumpModel
@{
}

@section Meta {
    <title>
        Ta bort bilaga -
        @(Branding.WebsiteTitle)
    </title>
}

@section Header {
    <partial name="_Navbar" model="Model.UserToken" />
}

<main>
    <h4>
        Ta bort bilagan:
        @(Model.DataDump.Name)
    </h4>

    <form method="post">

        <input type="hidden" asp-for="CommandModel.DataDumpId" />

        <p>
            <label asp-for="CommandModel.Confirmed">
                <input asp-for="CommandModel.Confirmed" type="checkbox" />
                Ja, jag är säker
            </label>
        </p>

        <div asp-validation-summary="All"></div>

        <button type="submit">
            Ta bort
        </button>

        <a class="button" href="/show-data-dump/@(Model.CommandModel.DataDumpId)">
            Avbryt
        </a>
    </form>

</main>
